    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Launch API Server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/backend/cmd/api"
        },
        {
            "name": "Run Refresh Tasks Job",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/backend/cmd/refresh_tasks"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Frontend: npm run dev",
            "cwd": "${workspaceFolder}/frontend",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
              "run",
              "dev"
            ],
            "console": "integratedTerminal"
        }
    ]
}